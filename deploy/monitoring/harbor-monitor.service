[Unit]
Description=Harbor production health and ilert heartbeat
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=config.json:/etc/harbor-monitor/config.json
ExecStart=/usr/bin/python3 /opt/harbor-monitor/check.py internal --config %d/config.json --state /var/lib/harbor-monitor/state.json
StateDirectory=harbor-monitor
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=180
