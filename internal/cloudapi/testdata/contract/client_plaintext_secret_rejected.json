{
  "name": "client_plaintext_secret_rejected",
  "spec_scenario": "A plaintext (non-hex-digest) client_secret_hash is rejected",
  "steps": [
    {
      "method": "POST",
      "path": "/admin/v1/namespaces",
      "auth": "valid",
      "scope": "namespaces:write",
      "idempotency_key": "plaintext-ns-key",
      "request_body": {"id": "contract-plaintext-ns"},
      "want_status": 201
    },
    {
      "method": "POST",
      "path": "/admin/v1/namespaces/contract-plaintext-ns/clients",
      "auth": "valid",
      "scope": "clients:write",
      "idempotency_key": "plaintext-secret-key",
      "request_body": {
        "client_id": "plaintext-secret-client",
        "redirect_uris": ["https://contract-client.example.com/cb"],
        "client_secret_hash": "hunter2-this-is-a-plaintext-secret-not-a-hex-digest"
      },
      "want_status": 400,
      "want_error_code": "invalid_request"
    }
  ]
}
