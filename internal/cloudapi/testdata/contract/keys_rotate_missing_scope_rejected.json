{
  "name": "keys_rotate_missing_scope_rejected",
  "spec_scenario": "Missing keys:rotate scope is rejected",
  "steps": [
    {
      "method": "POST",
      "path": "/admin/v1/keys/rotate",
      "auth": "valid",
      "scope": "namespaces:read",
      "want_status": 403,
      "want_error_code": "insufficient_scope"
    }
  ]
}
