{
  "name": "namespace_idempotency_key_reused_different_body",
  "spec_scenario": "Reused idempotency key with a different body is rejected",
  "steps": [
    {
      "method": "POST",
      "path": "/admin/v1/namespaces",
      "auth": "valid",
      "scope": "namespaces:write",
      "idempotency_key": "ns-key-2",
      "request_body": {"id": "contract-ns-2"},
      "want_status": 201,
      "want_body_contains": {"id": "contract-ns-2"}
    },
    {
      "method": "POST",
      "path": "/admin/v1/namespaces",
      "auth": "valid",
      "scope": "namespaces:write",
      "idempotency_key": "ns-key-2",
      "request_body": {"id": "contract-ns-other"},
      "want_status": 409,
      "want_error_code": "idempotency_key_reused"
    }
  ]
}
